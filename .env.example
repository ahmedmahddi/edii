# Accounts and client workspaces (Supabase: see README, "Accounts and client workspaces").
# Without them the app runs in local mode (no account, registers kept in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (Vercel → Environment Variables; never prefixed NEXT_PUBLIC_).
# The weekly digest e-mail (app/api/notifications/cron): reads every workspace, so it needs the
# service role key; sends through Resend or Brevo; CRON_SECRET guards the scheduled calls and signs
# the unsubscribe links.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
# or BREVO_API_KEY=
NOTIFY_FROM=ABClassement <noreply@your-domain.tn>
NEXT_PUBLIC_SITE_URL=https://abclassement.vercel.app
