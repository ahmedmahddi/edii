{
  "name": "edii",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Classement des établissements dangereux, insalubres ou incommodes (Tunisie) et étude environnementale ANPE",
  "scripts": {
    "predev": "tsx scripts/veille.ts --reassess",
    "dev": "next dev",
    "prebuild": "tsx scripts/veille.ts --reassess",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "db:types": "bash scripts/db-types.sh",
    "test:e2e": "playwright test",
    "data:ocr": "node scripts/python.mjs data/pipeline/ocr.py",
    "data:parse": "node scripts/python.mjs data/pipeline/parse.py",
    "data:eie": "node scripts/python.mjs data/pipeline/eie.py",
    "veille": "tsx scripts/veille.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "5.90.2",
    "cmdk": "1.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "1.72.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
